# 환경 변수 예시 — 이 파일을 복사해 .env 로 저장 후 실제 값을 입력하세요.
# .env는 절대 Git에 커밋하지 마세요.

# ── KIS API 인증 (하이브리드 모드) ─────────────────────
# 데이터 조회는 무조건 실전 키를 사용하고, 주문은 KIS_IS_PAPER 값에 따라 분기됩니다.

# 실전투자 키 (필수: 데이터 조회 및 실전 매매용)
KIS_REAL_APP_KEY=여기에_실전투자_앱키_입력
KIS_REAL_APP_SECRET=여기에_실전투자_앱시크릿_입력
KIS_REAL_ACCOUNT_NO=12345678-01    # 실전 계좌번호

# 모의투자 키 (선택: 모의투자 테스트 시 필요)
KIS_PAPER_APP_KEY=여기에_모의투자_앱키_입력
KIS_PAPER_APP_SECRET=여기에_모의투자_앱시크릿_입력
KIS_PAPER_ACCOUNT_NO=50123456-01   # 모의 계좌번호

# 매매 모드 선택
KIS_IS_PAPER=true             # true: 모의투자 시스템 연결 / false: 실전투자 시스템 연결

# ── Anthropic Claude / OpenAI / Qwen (선택) ───────────
OPENAI_API_KEY=your_openai_or_qwen_api_key_here

# ── Arbiter LLM Endpoint ─────────────────────────────
ARBITER_BASE_URL=http://127.0.0.1:1234/v1/chat/completions
ARBITER_MODEL=qwen/qwen3.8-27b

# ── NAVER Search API (뉴스/커뮤니티 검색용) ─────────────
NAVER_CLIENT_ID=your_naver_client_id_here
NAVER_CLIENT_SECRET=your_naver_client_secret_here
