    "version": "0.2.0",
    "configurations": [        
        {
            "name": "Main",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            // "args": ["--ticker", "069500", "--interval", "3"]
            "args": ["--ticker", "069500"]
        },
        {
            "name": "Simulate",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/sim_logs.py",
            "args": ["--ticker", "069500"]
        },
        {
            "name": "Chart",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/make_charts.py",
            "args": ["--ticker", "005930", "--interval", "1"]
        },        
        {
            "name": "Report",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/report.py",
            "args": ["--paper"
            ]
        },
        {
            "name": "Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/test_filters.py",
                "-v"
            ]
        },
        {
            "name": "Test Gate3 BUY Candle",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/test_filters.py::TestGate3ClaudeFilter::test_pass_high_confidence_buy_with_candle_pattern",
                "-v"
            ]
        },
        {
            "name": "Test Stop Loss",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "tests/test_filters.py::TestRiskManager::test_stop_loss_price",
                "-v"
            ]
        }

    ]
}